DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# "email" for now, switch to "sms" once Kavenegar (or another gateway) is purchased
NOTIFICATION_CHANNEL=email

# Console backend prints emails to the terminal instead of sending them — free, zero setup, dev-only.
# Swap to django.core.mail.backends.smtp.EmailBackend once you have real SMTP credentials (e.g. Gmail app password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourapp.local

# Local testing only: displays OTP in the browser; requires DJANGO_DEBUG=1.
OTP_DELIVERY_MODE=development
