# Copy to .env.staging at the project root. Never commit the real file.
SITE_DOMAIN=staging.example.com
DJANGO_SECRET_KEY=
POSTGRES_DB=tellbook_staging
POSTGRES_USER=tellbook
POSTGRES_PASSWORD=
# Independent random proxy-to-backend secret (not the browser password):
STAGING_GATE_SECRET=
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Paste bcrypt hash in SINGLE QUOTES to preserve dollar signs:
STAGING_PASSWORD_HASH=''

# Optional: use tested prebuilt images (docker load the release archive first).
# TELLBOOK_APP_IMAGE=tellbook-staging-app:2026-10-26
# TELLBOOK_EDGE_IMAGE=tellbook-staging-edge:2026-10-26
